---
import '../global.css';
import { Nav } from '../components/nav';

type Props = {
  title: string;
  brand: string;
  hasSidebar?: boolean;
};

const { title, brand, hasSidebar = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="dark-palette">
    <!-- Load theme before paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'light') {
          document.body.classList.remove('dark-palette');
          document.body.classList.add('light-palette');
        }
      })();
    </script>
    <!-- Load checkmarks in curriculum map before paint -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('progress');
          const completed = stored ? JSON.parse(stored) : [];
          if (!Array.isArray(completed)) {
            return;
          }

          const rules = completed
            .filter((slug) => typeof slug === 'string' && /^[a-z0-9-]+$/.test(slug))
            .map((slug) => `.completed-badge[data-lesson-slug="${slug}"]{display:inline}`)
            .join('');

          if (!rules) {
            return;
          }

          const style = document.createElement('style');
          style.textContent = rules;
          document.head.appendChild(style);
        } catch {
          // ignore malformed stored progress
        }
      })();
    </script>
    <Nav brand={brand} showSidebarToggle={hasSidebar} client:load />
    <slot />
    <!-- Close the sidebar (and reveal the content behind it) before paint on narrow viewports -->
    <script is:inline>
      (function () {
        if (window.innerWidth > 600) {
          return;
        }
        const sidebar = document.querySelector('.sidebar');
        if (sidebar) {
          sidebar.classList.add('closed');
        }
        const main = document.querySelector('.main');
        if (main) {
          main.classList.remove('sidebar-open');
        }
      })();
    </script>
  </body>
</html>
