---
import { getCollection } from 'astro:content';
import Layout from '../layouts/layout.astro';
import { Progress } from '../views/progress';
import { loadManifest } from '../lib/load-manifest';
import { getOrderedLessons } from '../lib/curriculum-route-utils';
import type { CurriculumNav } from '../lib/curriculum-types';

const manifest = await loadManifest();
const allLessons = await getCollection('lessons');
const lessonTitleMap = new Map(allLessons.map((lesson) => [lesson.id, lesson.data.title]));
const curriculum: CurriculumNav = {
  title: manifest.title,
  sections: manifest.sections.map((section) => ({
    title: section.title,
    modules: section.modules.map((module) => ({
      title: module.title,
      lessons: module.lessons.map((lesson) => ({
        title: lessonTitleMap.get(lesson.id) ?? lesson.id,
        id: lesson.id,
      })),
    })),
  })),
};
const lessons = getOrderedLessons(curriculum).map((entry) => ({
  slug: entry.slug,
  href: entry.href,
  section: entry.section.title,
}));
---

<Layout title={`Progress - ${curriculum.title}`} brand={curriculum.title}>
  <Progress lessons={lessons} client:load />
</Layout>
