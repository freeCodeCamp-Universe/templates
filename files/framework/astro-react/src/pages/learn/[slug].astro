---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '../../layouts/layout.astro';
import { Lesson } from '../../views/lesson';
import { loadCurriculum } from '../../lib/load-curriculum';
import { buildLearnPath, buildLessonRouteSlug } from '../../lib/curriculum-route-utils';

export const getStaticPaths = (async () => {
  const curriculum = await loadCurriculum();

  const entries = curriculum.sections.flatMap((sectionItem) =>
    sectionItem.modules.flatMap((moduleItem) =>
      moduleItem.lessons.map((lessonItem) => ({
        section: sectionItem,
        module: moduleItem,
        lesson: lessonItem,
      })),
    ),
  );

  return entries.map((entry, index) => {
    const nextEntry = entries[index + 1];
    const isLastLesson = nextEntry === undefined;

    return {
      params: {
        slug: buildLessonRouteSlug(entry.section, entry.module, entry.lesson),
      },
      props: {
        curriculum: {
          title: curriculum.title,
          sections: curriculum.sections.map((s) => ({
            title: s.title,
            modules: s.modules.map((m) => ({
              title: m.title,
              lessons: m.lessons.map((l) => ({ title: l.title })),
            })),
          })),
        },
        lesson: entry.lesson,
        isLastLesson,
        nextHref: isLastLesson
          ? '/learn'
          : buildLearnPath(nextEntry.section, nextEntry.module, nextEntry.lesson),
      },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { curriculum, lesson, isLastLesson, nextHref } = Astro.props;
---

<Layout title={lesson.title} brand={curriculum.title} hasSidebar>
  <Lesson
    curriculum={curriculum}
    lesson={lesson}
    isLastLesson={isLastLesson}
    nextHref={nextHref}
    client:load
  />
</Layout>
