---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '../../layouts/layout.astro';
import { Sidebar } from '../../components/sidebar';
import { Lesson } from '../../views/lesson';
import { loadCurriculum } from '../../lib/load-curriculum';
import { toCurriculumOutline } from '../../lib/curriculum-outline';
import { buildLearnPath, buildLessonRouteSlug } from '../../lib/curriculum-route-utils';

export const getStaticPaths = (async () => {
  const curriculum = await loadCurriculum();
  const curriculumOutline = toCurriculumOutline(curriculum);

  const entries = curriculum.sections.flatMap((sectionItem) =>
    sectionItem.modules.flatMap((moduleItem) =>
      moduleItem.lessons.map((lessonItem) => ({
        section: sectionItem,
        module: moduleItem,
        lesson: lessonItem,
      })),
    ),
  );

  return entries.map((entry, index) => {
    const nextEntry = entries[index + 1];
    const isLastLesson = nextEntry === undefined;
    const lessonSlug = buildLessonRouteSlug(entry.section, entry.module, entry.lesson);

    return {
      params: {
        slug: lessonSlug,
      },
      props: {
        curriculum: curriculumOutline,
        lesson: entry.lesson,
        lessonSlug,
        isLastLesson,
        nextHref: isLastLesson
          ? '/learn'
          : buildLearnPath(nextEntry.section, nextEntry.module, nextEntry.lesson),
      },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { curriculum, lesson, lessonSlug, isLastLesson, nextHref } = Astro.props;
---

<Layout title={lesson.title} brand={curriculum.title} hasSidebar>
  <div class="lesson-layout">
    <Sidebar curriculum={curriculum} client:load />
    <Lesson
      lesson={lesson}
      lessonSlug={lessonSlug}
      isLastLesson={isLastLesson}
      nextHref={nextHref}
      client:load
    />
  </div>
</Layout>
