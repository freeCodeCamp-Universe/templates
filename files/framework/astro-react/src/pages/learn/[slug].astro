---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '../../layouts/layout.astro';
import { Lesson } from '../../views/lesson';
import { loadCurriculum } from '../../lib/load-curriculum';
import { buildLessonRouteSlug } from '../../lib/curriculum-route-utils';

export const getStaticPaths = (async () => {
  const curriculum = await loadCurriculum();

  return curriculum.sections.flatMap((sectionItem) =>
    sectionItem.modules.flatMap((moduleItem) =>
      moduleItem.lessons.map((lessonItem) => ({
        params: {
          slug: buildLessonRouteSlug(sectionItem, moduleItem, lessonItem),
        },
        props: { lesson: lessonItem, curriculum },
      })),
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { curriculum, lesson } = Astro.props;
---

<Layout title={lesson.title} brand={curriculum.title} hasSidebar>
  <Lesson curriculum={curriculum} lesson={lesson} client:load />
</Layout>
