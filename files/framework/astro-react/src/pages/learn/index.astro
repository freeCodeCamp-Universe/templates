---
import Layout from '../../layouts/layout.astro';
import { Learn } from '../../views/learn';
import { loadCurriculum } from '../../lib/load-curriculum';
import { toCurriculumOutline } from '../../lib/curriculum-outline';

const curriculum = await loadCurriculum();
const curriculumOutline = toCurriculumOutline(curriculum);
---

<Layout title={`${curriculum.title}`} brand={curriculum.title}>
  <Learn curriculum={curriculumOutline} client:load />
</Layout>
