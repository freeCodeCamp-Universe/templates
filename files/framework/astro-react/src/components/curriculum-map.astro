---
import './curriculum-map.css';
import type { CurriculumOutline } from '../lib/curriculum-outline';
import { buildLearnPath, buildLessonRouteSlug } from '../lib/curriculum-route-utils';

type Props = {
  curriculum: CurriculumOutline;
  currentLessonSlug?: string;
};

const { curriculum, currentLessonSlug } = Astro.props;
---

<nav aria-label="Curriculum sections" class="navigation">
  {
    curriculum.sections.map((section) => {
      const containsCurrentLesson = (moduleTitle: string, lessons: { title: string }[]) =>
        lessons.some(
          (lesson) =>
            buildLessonRouteSlug(section.title, moduleTitle, lesson.title) === currentLessonSlug,
        );

      // Learn page has no current lesson -> everything it expanded
      // Lesson page has current lesson -> expand that section
      const sectionOpen =
        !currentLessonSlug ||
        section.modules.some((module) => containsCurrentLesson(module.title, module.lessons));

      const moduleCount = section.modules.length;

      return (
        <details class="section" open={sectionOpen}>
          <summary>
            <h2>{section.title}</h2>
            <span class="count">
              {moduleCount} {moduleCount === 1 ? 'module' : 'modules'}
            </span>
          </summary>

          <div class="modules">
            {section.modules.map((module) => {
              const moduleOpen =
                !currentLessonSlug || containsCurrentLesson(module.title, module.lessons);
              const lessonSlugs = module.lessons.map((lesson) =>
                buildLessonRouteSlug(section.title, module.title, lesson.title),
              );

              return (
                <details class="module-block" open={moduleOpen}>
                  <summary>
                    <h3>{module.title}</h3>
                    <span class="count" data-module-lessons={lessonSlugs.join(' ')}>
                      0/{lessonSlugs.length}
                    </span>
                  </summary>
                  <ul class="list">
                    {module.lessons.map((lesson, index) => {
                      const slug = lessonSlugs[index];
                      const isCurrent = slug === currentLessonSlug;

                      return (
                        <li class="item">
                          <a
                            href={buildLearnPath(section.title, module.title, lesson.title)}
                            aria-current={isCurrent ? ('page' as const) : undefined}
                            class={isCurrent ? 'item-link current' : 'item-link'}
                            data-lesson-slug={slug}
                          >
                            <span class="check" aria-hidden="true" />
                            <span class="item-title">{lesson.title}</span>
                            <span class="sr-only status-complete"> Completed</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              );
            })}
          </div>
        </details>
      );
    })
  }
</nav>

<script is:inline>
  (function () {
    try {
      const stored = localStorage.getItem('progress');
      const parsed = stored ? JSON.parse(stored) : [];
      if (!Array.isArray(parsed)) return;

      const completed = new Set(
        parsed.filter((slug) => typeof slug === 'string' && /^[a-z0-9-]+$/.test(slug)),
      );

      for (const slug of completed) {
        const link = document.querySelector('.item-link[data-lesson-slug="' + slug + '"]');
        if (link) link.classList.add('completed');
      }

      for (const counter of document.querySelectorAll('[data-module-lessons]')) {
        const slugs = counter.dataset.moduleLessons.split(' ').filter(Boolean);
        const done = slugs.filter((slug) => completed.has(slug)).length;
        counter.textContent = done + '/' + slugs.length;
        if (done === slugs.length) counter.classList.add('count-complete');
      }
    } catch {
      // ignore malformed stored progress
    }
  })();
</script>
