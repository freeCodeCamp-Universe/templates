---
import CurriculumMap from '../components/curriculum-map.astro';
import type { CurriculumNav } from '../lib/curriculum-types';

import './views.css';

type Props = {
  curriculum: CurriculumNav;
};

const { curriculum } = Astro.props;
---

<main id="main-content" class="main" tabindex="-1">
  <header class="page-heading">
    <h1 class="page-label">Learn</h1>
    <hr class="page-label-divider" />
  </header>

  <CurriculumMap curriculum={curriculum} />
</main>
